{
  "manifest_version": 3,
  "name": "zerodom",
  "version": "0.1.5",
  "description": "Drive your real, logged-in Chrome as a zerodom identity for authenticated access-control testing (IDOR/BOLA). Run one per profile to test as two users at once — real sessions, real fingerprints, no bot-detection wall.",
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "zerodom",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
